#!/usr/bin/env bash
# Execs the cross-compiled Windows binary from WSL, so `wh` can drive the keyboard through the
# Windows HID stack without a Windows shell open. WSL only forwards an environment variable into
# a Windows process when it is named in WSLENV, so wh.exe otherwise never sees anything this
# shell exports.
set -euo pipefail

BIN_DIR="$(dirname "$(readlink -f "$0")")"
BIN="$BIN_DIR/../target/x86_64-pc-windows-gnu/release/wh.exe"

# WH_REPLAY is the only escape hatch from real hardware: set it to a capture script and every
# command reads a scripted conversation instead of opening the keyboard. If WSLENV does not carry
# WH_REPLAY across the WSL/Windows boundary, wh.exe sees it unset and silently drives the real
# device instead, which has actually turned a replay run into a real `wh restore --force` against
# an operator's board. Fail closed here: this shell is the only place that can check before the
# crossing happens.
if [ -n "${WH_REPLAY:-}" ]; then
    if ! command -v wslpath >/dev/null 2>&1; then
        echo "wh: WH_REPLAY is set but this does not look like a WSL interop shell (no wslpath" \
             "on PATH), so WH_REPLAY cannot be guaranteed to reach wh.exe; refusing to run rather" \
             "than risk a silent write to real hardware" >&2
        exit 1
    fi
    if ! wslpath -w -- "$WH_REPLAY" >/dev/null 2>&1; then
        echo "wh: WH_REPLAY=$WH_REPLAY does not resolve to a path wslpath can translate for" \
             "Windows, so it cannot be guaranteed to reach wh.exe; refusing to run rather than" \
             "risk a silent write to real hardware" >&2
        exit 1
    fi
    # /p tells WSL's interop layer to translate the value between WSL and Windows path syntax as
    # it crosses the boundary. Appended to any WSLENV the caller already set, not assigned over
    # it, so an operator's own WSLENV entries survive running `wh`.
    export WSLENV="${WSLENV:+$WSLENV:}WH_REPLAY/p"
fi

exec "$BIN" "$@"
